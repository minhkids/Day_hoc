    <TextBlock Text="Giấy nghỉ phép" FontSize="15" FontWeight="SemiBold" Foreground="#0B2B6B" Margin="0,8,0,2" TextWrapping="Wrap"/>
    <TextBlock Text="Mẫu 1.10 - NĐ 30" FontSize="12" Foreground="#5B6B7F" TextWrapping="Wrap"/>
  </StackPanel>
</Border><Border x:Name="LvLichTuan" Tag="/lich-tuan Lập lịch công tác tuần" Style="{StaticResource OChucNang}" Background="White" Padding="16,14">
