<TextBlock Text="VĂN BẢN ĐẦU NHIỆM KỲ, ĐẦU NĂM" FontSize="13" FontWeight="Bold" Foreground="#2F6FE0" Margin="8,10,6,8"/><UniformGrid Columns="3"><Border x:Name="DgQuyChe" Tag="lenh:/cong-tac-dang Quy chế làm việc của đảng ủy" Style="{StaticResource OChucNang}" Background="White" Padding="18,16">
