    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#2F6FE0"/>
    <TextBlock Text="Lịch công tác tuần" FontSize="15" FontWeight="SemiBold" Foreground="#0B2B6B" Margin="0,8,0,2" TextWrapping="Wrap"/>
    <TextBlock Text="Bảng lịch có phân công" FontSize="12" Foreground="#5B6B7F" TextWrapping="Wrap"/>
  </StackPanel>
</Border><Border x:Name="LvPhieu" Tag="/van-ban-den Lập phiếu giải quyết văn bản đến" Style="{StaticResource OChucNang}" Background="White" Padding="16,14">
