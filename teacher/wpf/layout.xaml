                      <TextBlock x:Name="TxtBuoc" Text="Đang đọc yêu cầu..." FontSize="13.5" FontWeight="SemiBold" Foreground="#1F3354" TextTrimming="CharacterEllipsis" Margin="0,0,120,0"/>
