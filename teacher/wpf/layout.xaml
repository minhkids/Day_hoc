                </Grid>
              </Border>
            </Grid>
          </Grid>
        </Grid>

        <!-- ========== HỒ SƠ CHUYÊN MÔN ========== -->
        <ScrollViewer x:Name="PgNhiemVu" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
