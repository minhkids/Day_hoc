                    </Button>
                    <Button x:Name="BtnXemAn" Style="{StaticResource Lien}" Padding="6,4" VerticalAlignment="Center" ToolTip="Ẩn khung xem trước"><TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#40546B"/></Button>
