<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Trợ lý Giáo viên Mầm non" Width="1380" Height="900" MinWidth="1060" MinHeight="700" WindowStartupLocation="CenterScreen"
 Background="#F5F7F5" FontFamily="Segoe UI" FontSize="14" Foreground="#183C38" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="15,10"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Background" Value="#E8F2EE"/><Setter Property="Foreground" Value="#164B43"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Bg" CornerRadius="9" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter RecognizesAccessKey="True" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#207465"/><Setter Property="Foreground" Value="White"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#EAF5EF"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,2"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#D6E3DC"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="MinHeight" Value="36"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  <Style TargetType="ListBox"><Setter Property="BorderBrush" Value="#D6E3DC"/><Setter Property="Background" Value="White"/><Setter Property="Padding" Value="6"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="254"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#173F39" Padding="16,20,16,14">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="10,0,0,18">
     <TextBlock Text="MẦM NON" Foreground="#EFCF87" FontSize="13" FontWeight="Bold"/>
     <TextBlock Text="Trợ lý Giáo viên" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,7,0,5"/>
     <TextBlock Text="Không gian làm việc của cô" Foreground="#B4D4C8" FontSize="12"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="4,12,0,0">
     <Separator Background="#356158"/>
     <Button x:Name="BtnSchool" Style="{StaticResource Nav}" Content="Không gian trường học ↗" FontSize="12"/>
     <TextBlock Text="Phiên bản mầm non · 1.0.1" Foreground="#A7C8BA" FontSize="11" Margin="10,8,0,0"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="NavPanel"/></ScrollViewer>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="30,22,30,14">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="PageTitle" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Foreground="#668077" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
    <Border Grid.Column="1" Background="#E9F1EA" CornerRadius="18" Padding="14,9" VerticalAlignment="Top" Margin="15,0,0,0"><TextBlock x:Name="ProfileBadge" Text="Lớp của cô" FontSize="12"/></Border>
   </Grid>
   <Grid Grid.Row="1">
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="PageBody" Margin="0,0,12,0"/></ScrollViewer>
    <Grid x:Name="EditorPanel" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBox x:Name="DocTitle" FontSize="19"/>
     <WrapPanel Grid.Row="1" Margin="0,0,0,8"><Button x:Name="BtnSaveDoc" Content="Lưu tài liệu" Style="{StaticResource Primary}"/><Button x:Name="BtnDocAI" Content="Soạn tiếp với AI"/><Button x:Name="BtnImport" Content="Mở tệp"/><Button x:Name="BtnWord" Content="Xuất Word"/><Button x:Name="BtnSlides" Content="PowerPoint"/><Button x:Name="BtnExcel" Content="Excel"/></WrapPanel>
     <TextBox Grid.Row="2" x:Name="DocBody" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="15" Padding="22"/>
     <TextBlock Grid.Row="3" Text="Có thể sửa và lưu trực tiếp. Các mẫu là gợi ý; điều chỉnh theo độ tuổi và mẫu của trường." Foreground="#668077" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </Grid>
    <Grid x:Name="ChatPanel" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <WrapPanel><Button x:Name="BtnNewChat" Content="Chat mới"/><Button x:Name="BtnClearChat" Content="Xóa hội thoại"/><Button x:Name="BtnAttach" Content="Đính kèm"/><Button x:Name="BtnToEditor" Content="Lưu vào tài liệu"/></WrapPanel>
     <TextBox Grid.Row="1" x:Name="ChatHistory" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="15" Padding="20" Margin="0,12,0,8"/>
     <DockPanel Grid.Row="2"><Button x:Name="BtnClearFiles" Content="Bỏ đính kèm" DockPanel.Dock="Right"/><TextBlock x:Name="FileStatus" Text="Chưa đính kèm tài liệu" TextWrapping="Wrap" Foreground="#668077" VerticalAlignment="Center"/></DockPanel>
     <TextBox Grid.Row="3" x:Name="ChatPrompt" Height="115" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12"/>
     <DockPanel Grid.Row="4"><Button x:Name="BtnSend" DockPanel.Dock="Right" Content="Gửi yêu cầu" Style="{StaticResource Primary}"/><Button x:Name="BtnCancel" DockPanel.Dock="Right" Content="Hủy yêu cầu" IsEnabled="False"/><TextBlock Text="Hội thoại chỉ giữ trong phiên. Chủ động lưu câu trả lời cần dùng vào Kho tài liệu." TextWrapping="Wrap" Foreground="#668077" VerticalAlignment="Center"/></DockPanel>
    </Grid>
   </Grid>
   <TextBlock Grid.Row="2" x:Name="Status" Text="Sẵn sàng" Foreground="#668077" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"/>
  </Grid>
 </Grid>
</Window>
